<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<RootNamespace>GMN_Core</RootNamespace>
		<BaseOutputPath></BaseOutputPath>
		<PlatformTarget>AnyCPU</PlatformTarget>
		<Nullable>annotations</Nullable>
		<Configurations>Debug;Release;Nullable</Configurations>
		<!-- ANGEL_ISLAND: Angel Island's core (the music system's #if ANGEL_ISLAND code; without it AIMS builds for stock RunUO) -->
		<DefineConstants>$(DefineConstants);ANGEL_ISLAND</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<WarningsAsErrors>$(WarningsAsErrors);NU1605;CS0108</WarningsAsErrors>
		<NoWarn>1701;1702;CS0649;CS0642;CS0162;CS0414;CS0168;CS0612;SYSLIB0022;CS0618;CS0219;SYSLIB0021;SYSLIB0014</NoWarn>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<WarningsAsErrors>$(WarningsAsErrors);NU1605;CS0108</WarningsAsErrors>
		<NoWarn>1701;1702;CS0649;CS0642;CS0162;CS0414;CS0168;CS0612;SYSLIB0022;CS0618;CS0219;SYSLIB0021;SYSLIB0014</NoWarn>
	</PropertyGroup>

	<!-- Nullable: same as Debug, plus full nullable analysis -->
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Nullable|AnyCPU'">
		<DebugSymbols>true</DebugSymbols>
		<Optimize>false</Optimize>
		<DisableImplicitConfigurationDefines>true</DisableImplicitConfigurationDefines>
		<DefineConstants>$(DefineConstants);DEBUG</DefineConstants>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<WarningsAsErrors>$(WarningsAsErrors);NU1605;CS0108</WarningsAsErrors>
		<NoWarn>1701;1702;CS0649;CS0642;CS0162;CS0414;CS0168;CS0612;SYSLIB0022;CS0618;CS0219;SYSLIB0021;SYSLIB0014</NoWarn>
		<Nullable>enable</Nullable>
	</PropertyGroup>

