	<!-- BuildInfo.exe (the BuildInfo project, built into this folder) writes "Core 6.info", the build number. Called by its
	     full path: cmd won't run a bare name from the current folder when NoDefaultCurrentDirectoryInExePath is set (exit
	     9009, MSB3073), and that failure marked GMN Core failed, so a fresh clone never built the Patches DLLs. Skipped
	     until BuildInfo.exe exists (the server starts without "Core 6.info": version 0.0.0). 11/6/26, Adam -->
	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
	  <Exec Command="&quot;$(MSBuildProjectDirectory)\BuildInfo.exe&quot;" Condition="Exists('$(MSBuildProjectDirectory)\BuildInfo.exe')" />
	</Target>

