<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<RootNamespace>GMN_Core</RootNamespace>
		<BaseOutputPath></BaseOutputPath>
		<PlatformTarget>AnyCPU</PlatformTarget>
		<Nullable>annotations</Nullable>
		<Configurations>Debug;Release;Nullable</Configurations>
		<!-- ANGEL_ISLAND: Angel Island's core (the music system's #if ANGEL_ISLAND code; without it AIMS builds for stock RunUO) -->
		<DefineConstants>$(DefineConstants);ANGEL_ISLAND</DefineConstants>
	</PropertyGroup>

	<!-- The server's version, Major.Minor.Revision (6.1.1360): Major.Minor here; the revision is the SVN revision of the
	     last change anywhere in this folder (Directory.Build.targets, beside this file, explains the scheme). The patch
	     libraries carry the same version. The server reports it at startup ([about, [diag and the welcome too).
	     11/16/26, Adam: moved here from BuildInfo\Program.cs (BuildInfo retired), its history with it:

	     8/30/2024, Adam
	         Reverting major version to 6. This reflects our actual Core version.
	     7/28/2024, Adam
	         Bump the major version to 7. This will be our new GitHub version
	     12/26/21, Adam
	         Add Major and Minor version numbers

	     Version History:
	         10/29/22, Adam
	         Minor 1:
	             RunUO 2.6 networking.
	             Add Renaissance server support
	             Convert all Angel Island 'servers' to 'rule sets' so as not to conflict with RunUO's
	                 notion of Expansion's
	         7/3/22, Adam
	         Major 6: (Minor 0)
	             New map and client 6.0.1.10
	             Upgrade Map.cs, Sector.cs, and Tile modules to RunUO 2.6
	         Minor 2:
	             Move to .NET 6
	         Major 5:
	             Move to 64bit code
	             Move to .NET 5
	         Minor 1:
	             New Intelligent Dialog System
	             replaced Dictionary<> with ConcurrentDictionary<> for World Items and Mobiles.
	     If you change AppVersion, add to the Version History above. -->
	<PropertyGroup>
		<AppVersion>6.1</AppVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<WarningsAsErrors>$(WarningsAsErrors);NU1605;CS0108</WarningsAsErrors>
		<NoWarn>1701;1702;CS0649;CS0642;CS0162;CS0414;CS0168;CS0612;SYSLIB0022;CS0618;CS0219;SYSLIB0021;SYSLIB0014</NoWarn>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<WarningsAsErrors>$(WarningsAsErrors);NU1605;CS0108</WarningsAsErrors>
		<NoWarn>1701;1702;CS0649;CS0642;CS0162;CS0414;CS0168;CS0612;SYSLIB0022;CS0618;CS0219;SYSLIB0021;SYSLIB0014</NoWarn>
	</PropertyGroup>

	<!-- Nullable: same as Debug, plus full nullable analysis -->
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Nullable|AnyCPU'">
		<DebugSymbols>true</DebugSymbols>
		<Optimize>false</Optimize>
		<DisableImplicitConfigurationDefines>true</DisableImplicitConfigurationDefines>
		<DefineConstants>$(DefineConstants);DEBUG</DefineConstants>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<WarningsAsErrors>$(WarningsAsErrors);NU1605;CS0108</WarningsAsErrors>
		<NoWarn>1701;1702;CS0649;CS0642;CS0162;CS0414;CS0168;CS0612;SYSLIB0022;CS0618;CS0219;SYSLIB0021;SYSLIB0014</NoWarn>
		<Nullable>enable</Nullable>
	</PropertyGroup>

