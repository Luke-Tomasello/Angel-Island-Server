<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <Configurations>Debug;Release;Nullable</Configurations>
  </PropertyGroup>

  <!-- the server's version, 6.1.<revision>: the patch libraries carry GMN Core's (see ..\GMN Core.csproj and
       ..\Directory.Build.targets). 11/16/26, Adam -->
  <PropertyGroup>
    <AppVersion>6.1</AppVersion>
  </PropertyGroup>
  <ItemGroup>
    <AppVersionSource Include="..\" />
  </ItemGroup>

  <!-- Nullable: same as Debug, plus full nullable analysis -->
  <PropertyGroup Condition="'$(Configuration)'=='Nullable'">
    <DebugSymbols>true</DebugSymbols>
    <Optimize>false</Optimize>
    <DisableImplicitConfigurationDefines>true</DisableImplicitConfigurationDefines>
    <DefineConstants>$(DefineConstants);DEBUG</DefineConstants>
    <Nullable>enable</Nullable>
  </PropertyGroup>

	<PropertyGroup>
		<OutputPath>..\</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
	</PropertyGroup>

	<ItemGroup>
	  <ProjectReference Include="..\GMN Core.csproj" />
	</ItemGroup>

</Project>
