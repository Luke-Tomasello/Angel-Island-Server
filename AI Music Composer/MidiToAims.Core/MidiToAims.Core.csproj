<Project Sdk="Microsoft.NET.Sdk">
  <!-- MidiToAims converter library: used by the MidiToAims command line and the shard's [m2a command (loaded fresh on
       each run, never referenced at compile time). No shard dependencies.
       Built beside the server (like BuildInfo), where [m2a finds it and the installer (ShardSetup) picks it up. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <OutputPath>..\..\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
</Project>
