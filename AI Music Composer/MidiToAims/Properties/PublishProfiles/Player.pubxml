<?xml version="1.0" encoding="utf-8"?>
<!-- MidiToAims for players: one native MidiToAims.exe (Native AOT, about 2 MB), MidiToAims.Core compiled into it. It
     needs only Windows' own DLLs (kernel32, advapi32, ole32, bcrypt, the Universal CRT): no .NET install, Windows 10/11 x64.
     Native AOT needs Visual Studio's "Desktop development with C++" workload, and vswhere on the PATH (the PlayerZip
     target in MidiToAims.csproj adds it).
     dotnet publish MidiToAims.csproj -p:PublishProfile=Player -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>none</DebugType>
    <PublishDir>bin\Player\</PublishDir>
  </PropertyGroup>
</Project>
